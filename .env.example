# Web: copy relevant values to apps/web/.env.local
NEXT_PUBLIC_API_URL=http://localhost:2024
NEXT_PUBLIC_ASSISTANT_ID=lyl_counsel_agent
NEXT_PUBLIC_AUTH_SCHEME=

# Agent: copy relevant values to apps/agent/.env
# "stub" runs locally without a paid model account.
LYL_MODEL_PROVIDER=stub
LYL_MODEL=local-stub
LYL_MODEL_API_KEY=
LYL_MODEL_BASE_URL=
LYL_STUB_RESPONSE=本地 LangGraph 基线已连接。
